{
  "name": "dsh-insert-context",
  "version": "1.3.0",
  "description": "Insert a configurable context message into the agent's own context on chosen executed steps — from step X, every Y steps, Z times, with {{step}} filled in — and optionally append a sentence to every user message · 在第 X 步起每 Y 步注入一次自定义上下文（共 Z 次，文案支持 {{step}} 占位），并可在每条用户消息末尾追加一句话，两者均可在设置页配置",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/behaviour.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-loop",
    "context-injection",
    "insert-context",
    "step-rules"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}